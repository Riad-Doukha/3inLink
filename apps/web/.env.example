# Copy to .env.local (never committed) and fill in from Supabase: Project Settings → API.
# Only the public anon key belongs here. Never put the service_role key or the database password in the web app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
